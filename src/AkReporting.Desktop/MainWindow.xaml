<Window x:Class="AkReporting.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AkReporting.Desktop" Title="A K Diagnostic Reporting" Width="1280" Height="850" MinWidth="1000" MinHeight="700" Background="#F2F5FA">
  <DockPanel x:Name="Root">
    <Border DockPanel.Dock="Top" Background="#18374D" Padding="18,12"><StackPanel>
      <TextBlock Text="A K Diagnostic Centre &amp; Polyclinic" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="Reporting workspace • structured records • engineering validation release" Foreground="#D0E4EE"/>
    </StackPanel></Border>
    <Border DockPanel.Dock="Bottom" Padding="12" Background="White"><TextBlock x:Name="Status" Text="Connect to your local application host to sign in."/></Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
      <TextBox x:Name="Endpoint" Width="260" Text="https://localhost:7043"/><TextBox x:Name="Username" Width="160" ToolTip="Username"/>
      <PasswordBox x:Name="Password" Width="160" Margin="8,3" Padding="6"/><Button Content="Sign in" Click="Login_Click"/><Button Content="Sign out" Click="Logout_Click"/>
    </StackPanel>
    <Grid x:Name="Workspace" IsEnabled="False" Margin="16,0,16,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="255"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="Report cases" FontSize="16" FontWeight="SemiBold"/>
        <Button Content="Refresh saved cases" Click="Refresh_Click"/>
        <TextBox x:Name="CaseQuery" ToolTip="Search patient name, patient ID or public report number"/>
        <WrapPanel><Button Content="Search" Click="Search_Click"/><Button Content="Older" Click="Older_Click"/><Button Content="New case" Click="NewCase_Click"/></WrapPanel>
        <ListBox x:Name="Cases" Height="150" DisplayMemberPath="Patient.Name" SelectionChanged="Cases_Changed"/>
        <TextBlock Text="Investigations — select one or more" Margin="0,12,0,4"/>
        <ListBox x:Name="Investigations" Height="160" SelectionMode="Multiple" DisplayMemberPath="Title"/>
        <Button Content="Create case + selected reports" Click="Create_Click"/>
        <TextBlock Text="Separate reports in selected case" Margin="0,12,0,4"/>
        <ListBox x:Name="Reports" Height="160" DisplayMemberPath="PublicNumber" SelectionChanged="Reports_Changed"/>
        <Button Content="Add selected investigations to case" Click="AddReports_Click"/>
      </StackPanel>
      <TabControl Grid.Column="1" x:Name="Tabs">
        <TabItem Header="Patient / specimen"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18"><local:MetadataEditor x:Name="Metadata"/></ScrollViewer></TabItem>
        <TabItem Header="Results and revision">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="ReportTitle" FontSize="18" FontWeight="SemiBold" Text="Select a saved report"/>
              <TextBlock Text="Pinned authorizing doctor version"/><ComboBox x:Name="Doctors" DisplayMemberPath="DisplayName" SelectionChanged="Editor_Changed"/>
              <WrapPanel><ComboBox x:Name="FontFamilyBox" Width="130" SelectionChanged="Editor_Changed"/><TextBlock Text="Font size (8–14 pt)" VerticalAlignment="Center"/><TextBox x:Name="FontSizeBox" Width="50" Text="10" TextChanged="Editor_Changed"/>
                <CheckBox x:Name="BoldBox" Content="Bold" Margin="12,8" Checked="Editor_Changed" Unchecked="Editor_Changed"/><CheckBox x:Name="ItalicBox" Content="Italic" Margin="8" Checked="Editor_Changed" Unchecked="Editor_Changed"/>
                <CheckBox x:Name="UnderlineBox" Content="Underline" Margin="8" Checked="Editor_Changed" Unchecked="Editor_Changed"/><ComboBox x:Name="AlignmentBox" Width="100" SelectionChanged="Editor_Changed"/></WrapPanel>
              <TextBlock Text="Correction / save reason"/><TextBox x:Name="Reason" MaxLength="2000"/>
              <TextBlock Text="Center authorization basis (required only when issuing)"/><TextBox x:Name="AuthorizationBasis" MaxLength="4000"/>
              <WrapPanel><Button Content="Save new revision" Click="Save_Click"/><Button Content="Issue reviewed configuration" Click="Issue_Click"/><Button Content="Load revision history" Click="History_Click"/></WrapPanel>
              <ComboBox x:Name="History" DisplayMemberPath="Number" SelectionChanged="History_Changed"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><local:ResultEditor x:Name="ResultsEditor"/></ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Preview / output">
          <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="12"><Button Content="Preview saved revision" Click="Preview_Click"/><Button Content="Export PDF" Click="Pdf_Click"/><Button Content="Export DOCX" Click="Docx_Click"/><Button Content="Direct A4 print" Click="Print_Click"/></WrapPanel>
            <DocumentViewer x:Name="Preview"/></DockPanel>
        </TabItem>
        <TabItem x:Name="AdministrationTab" Header="Catalog / administration"><ScrollViewer Padding="18" VerticalScrollBarVisibility="Auto"><local:CatalogPanel x:Name="Catalog"/></ScrollViewer></TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
