<Window x:Class="AkReporting.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AkReporting.Desktop"
        Title="A K Diagnostic Reporting" Width="1280" Height="860" MinWidth="1000" MinHeight="690" WindowStartupLocation="CenterScreen" Background="#F3F6FA" Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="14">
  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Workspace" Visibility="Collapsed" IsEnabled="False">
      <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="White" BorderBrush="#DFE7EF" BorderThickness="0,0,0,1" Padding="24,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="SignedInAs" VerticalAlignment="Center" Margin="0,0,16,0"/><Button Content="Sign out" Click="Logout_Click"/></StackPanel>
          <Image x:Name="HeaderLogo" DockPanel.Dock="Left" Width="50" Height="50" Margin="0,0,14,0" Stretch="Uniform" Visibility="Collapsed"/>
          <StackPanel VerticalAlignment="Center"><TextBlock Text="A K Diagnostic Reporting" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Patient reports · save, preview and print" Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel>
        </DockPanel>
      </Border>
      <Grid Grid.Row="1" Margin="18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="265"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,16,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top">
              <Button Content="+  New report" Style="{StaticResource PrimaryButton}" Click="NewCase_Click"/>
              <TextBlock Text="Saved patients" FontWeight="SemiBold" FontSize="17" Margin="0,18,0,4"/>
              <TextBlock Text="Search by name, ID or report number" FontSize="12" Foreground="{StaticResource Muted}"/>
              <TextBox x:Name="CaseQuery" KeyDown="Search_KeyDown" ToolTip="Search saved patients"/>
              <WrapPanel><Button Content="Search" Click="Search_Click"/><Button Content="Refresh" Click="Refresh_Click"/></WrapPanel>
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="More patients" Click="Older_Click"/><Button x:Name="ManageButton" Content="Doctors &amp; settings" Click="Manage_Click"/><Button Content="Quick start guide" Click="Help_Click"/></StackPanel>
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <ListBox x:Name="Cases" MinHeight="110" SelectionChanged="Cases_Changed">
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Patient.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Grid.Row="1" Text="Reports for selected patient" FontWeight="SemiBold" Margin="0,16,0,6"/>
              <ListBox Grid.Row="2" x:Name="Reports" MinHeight="100" SelectionChanged="Reports_Changed">
                <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding TypeCode}" FontWeight="SemiBold"/><TextBlock Text="{Binding PublicNumber}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </DockPanel>
        </Border>
        <TabControl Grid.Column="1" x:Name="Tabs" Background="Transparent" BorderThickness="0" SelectionChanged="Tabs_Changed">
          <TabItem Header="1  Patient &amp; test">
            <DockPanel Margin="0,16,0,0">
              <Border DockPanel.Dock="Bottom" Background="White" Padding="16,8" Margin="0,10,0,0" CornerRadius="8"><WrapPanel><Button x:Name="CreateButton" Content="Continue to results  →" Style="{StaticResource PrimaryButton}" Click="Create_Click"/><Button x:Name="AddTestsButton" Content="Add tests to this patient" Click="AddReports_Click" Visibility="Collapsed"/></WrapPanel></Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
              <Border Style="{StaticResource Card}"><local:MetadataEditor x:Name="Metadata"/></Border>
              <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
                <TextBlock Text="Choose tests *" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="Tick one or more tests. Each test creates its own report." Foreground="{StaticResource Muted}" Margin="0,6,0,14"/>
                <ListBox x:Name="Investigations" SelectionMode="Multiple" MinHeight="130" MaxHeight="280">
                  <ListBox.ItemTemplate><DataTemplate><CheckBox AutomationProperties.Name="{Binding Title}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Focusable="True" Padding="6" HorizontalContentAlignment="Stretch">
                    <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding ReviewStatus, StringFormat='Configuration: {0}'}" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
                  </CheckBox></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="Draft configurations can be saved, previewed and exported for testing." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,10"/>
              </StackPanel></Border>
              </StackPanel></ScrollViewer>
            </DockPanel>
          </TabItem>
          <TabItem x:Name="ResultsTab" Header="2  Results">
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><DockPanel>
              <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="ReportTitle" FontSize="20" FontWeight="SemiBold" Text="Start a new report or open a saved report"/><TextBlock x:Name="SaveState" Text="Choose a patient and test in step 1." Foreground="{StaticResource Muted}" Margin="0,6,0,12"/></StackPanel>
              <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Separator/><WrapPanel><Button x:Name="SaveButton" Content="Save draft" Click="Save_Click"/><Button x:Name="SavePreviewButton" Content="Save &amp; preview  →" Style="{StaticResource PrimaryButton}" Click="SavePreview_Click"/></WrapPanel></StackPanel>
              <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ResultForm" IsEnabled="False">
                <local:ResultEditor x:Name="ResultsEditor"/>
                <Expander Header="Doctor signature / stamp (optional)" IsExpanded="True"><StackPanel><TextBlock Text="Select a doctor saved by the administrator. The saved signature and stamp are included in the report." Foreground="{StaticResource Muted}"/><ComboBox x:Name="Doctors" DisplayMemberPath="DisplayName" SelectionChanged="Editor_Changed"/><Button Content="Refresh doctor library" Click="RefreshDoctors_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
                <Expander Header="Formatting (optional)"><StackPanel>
                  <WrapPanel><ComboBox x:Name="FontFamilyBox" Width="160" SelectionChanged="Editor_Changed"/><TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,8,0"/><TextBox x:Name="FontSizeBox" Width="60" Text="10" TextChanged="Editor_Changed"/></WrapPanel>
                  <WrapPanel><CheckBox x:Name="BoldBox" Content="Bold" Margin="0,8,16,8" Checked="Editor_Changed" Unchecked="Editor_Changed"/><CheckBox x:Name="ItalicBox" Content="Italic" Margin="0,8,16,8" Checked="Editor_Changed" Unchecked="Editor_Changed"/><CheckBox x:Name="UnderlineBox" Content="Underline" Margin="0,8,16,8" Checked="Editor_Changed" Unchecked="Editor_Changed"/><ComboBox x:Name="AlignmentBox" Width="110" SelectionChanged="Editor_Changed"/></WrapPanel>
                </StackPanel></Expander>
                <Expander Header="Revision history / correction"><StackPanel><TextBlock Text="Save note (optional for drafts; required when correcting an issued report)"/><TextBox x:Name="Reason" MaxLength="2000"/><WrapPanel><Button Content="Load history" Click="History_Click"/><Button Content="Reload latest saved version" Click="Reload_Click"/></WrapPanel><ComboBox x:Name="History" DisplayMemberPath="Number" SelectionChanged="History_Changed"/></StackPanel></Expander>
                <Expander x:Name="IssuePanel" Header="Final issue — reviewed reports only"><StackPanel><TextBlock Text="Final issue needs an approved configuration, authorizing doctor and actual center authorization. Draft saving and export do not need this." Foreground="{StaticResource Muted}"/><TextBlock Text="Center authorization basis" Margin="0,8,0,0"/><TextBox x:Name="AuthorizationBasis" MaxLength="4000"/><Button Content="Issue reviewed report" Click="Issue_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
              </StackPanel></ScrollViewer>
            </DockPanel></Border>
          </TabItem>
          <TabItem x:Name="OutputTab" Header="3  Preview &amp; export">
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16"><DockPanel>
              <StackPanel DockPanel.Dock="Top"><TextBlock Text="Preview the saved report" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="PDF is the printing reference. Export or print the exact saved revision." Foreground="{StaticResource Muted}" Margin="0,6,0,10"/><WrapPanel><Button Content="Refresh preview" Click="Preview_Click"/><Button Content="Export PDF" Style="{StaticResource PrimaryButton}" Click="Pdf_Click"/><Button Content="Export Word" Click="Docx_Click"/><Button Content="Print A4" Click="Print_Click"/></WrapPanel></StackPanel>
              <Grid><TextBlock x:Name="PreviewHint" Text="Save a report in step 2, then choose Save &amp; preview." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><DocumentViewer x:Name="Preview"/></Grid>
            </DockPanel></Border>
          </TabItem>
          <TabItem x:Name="AdministrationTab" Header="Administration" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><Border Style="{StaticResource Card}" Margin="0,16,0,0"><local:CatalogPanel x:Name="Catalog"/></Border></ScrollViewer></TabItem>
        </TabControl>
      </Grid>
    </Grid>
    <Grid x:Name="LoginPanel" Background="#F3F6FA">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#153C4A" Padding="48"><StackPanel VerticalAlignment="Center">
        <Image x:Name="LoginLogo" Height="130" Width="200" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,0,0,30" Visibility="Collapsed"/>
        <TextBlock Text="A K Diagnostic Centre&#x0a;&amp; Polyclinic" FontSize="34" FontWeight="SemiBold" Foreground="White"/>
        <TextBlock Text="A simpler way to prepare patient reports." FontSize="19" Foreground="#CBE0E6" Margin="0,20,0,32"/>
        <TextBlock Text="1   Patient name, date and test&#x0a;&#x0a;2   Enter results and save&#x0a;&#x0a;3   Preview, export or print" FontSize="16" Foreground="White"/>
      </StackPanel></Border>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Width="360" VerticalAlignment="Center" Margin="28,80,28,28">
        <TextBlock Text="Welcome back" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Sign in with your centre account." Foreground="{StaticResource Muted}" Margin="0,8,0,26"/>
        <TextBlock Text="Username" FontWeight="SemiBold"/><TextBox x:Name="Username" MaxLength="80" AutomationProperties.Name="Username"/>
        <TextBlock Text="Password" FontWeight="SemiBold"/><PasswordBox x:Name="Password" KeyDown="Login_KeyDown" AutomationProperties.Name="Password"/>
        <Button x:Name="LoginButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="0,8,0,14"/>
        <TextBlock x:Name="LoginFeedback" Text="Use the administrator or writer account chosen during setup." Foreground="{StaticResource Muted}"/>
        <Expander Header="Connection settings" Margin="0,24,0,0"><StackPanel><TextBlock Text="Local application host"/><TextBox x:Name="Endpoint" Text="https://localhost:7043"/><TextBlock Text="Keep the default on this PC. For a network client, use the host address supplied by your administrator." FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel></Expander>
      </StackPanel></ScrollViewer>
    </Grid>
    <Grid x:Name="SplashPanel" Background="#153C4A"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Image x:Name="SplashLogo" Width="180" Height="150" Stretch="Uniform" Margin="0,0,0,24" Visibility="Collapsed"/><TextBlock Text="A K Diagnostic Reporting" FontSize="30" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="Preparing your workspace" Foreground="#CBE0E6" HorizontalAlignment="Center" Margin="0,12,0,20"/><ProgressBar Width="220" Height="4" IsIndeterminate="True" Foreground="#59CAD4"/></StackPanel></Grid>
    <Border Grid.Row="1" Background="White" BorderBrush="#DFE7EF" BorderThickness="0,1,0,0" Padding="18,10"><DockPanel><ProgressBar x:Name="BusyIndicator" DockPanel.Dock="Right" Width="100" Height="4" Margin="12,0,0,0" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Preparing your workspace…" Foreground="{StaticResource Muted}"/></DockPanel></Border>
  </Grid>
</Window>
