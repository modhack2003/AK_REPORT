<Application x:Class="AkReporting.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,4,8,4"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,3,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="0,3,0,8"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Application.Resources>
</Application>
